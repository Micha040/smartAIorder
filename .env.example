# Kopieren nach .env und ausfüllen. .env NIEMALS committen.
SAP_BASE_URL=https://my404145-api.s4hana.cloud.sap/sap/opu/odata4/sap/api_salesorder/srvd_a2x/sap/salesorder/0001/
SAP_USER=API_HACKATHON
SAP_PASSWORD=

# Optional: Org-Daten für Kunden ohne bisherigen Auftrag (sonst werden sie vom letzten Auftrag übernommen).
# Werte aus einem echten XAN100-Auftrag (TA = Terminauftrag, VkOrg 1010, Vertriebsweg 10, Sparte 00).
SAP_DEFAULT_SALES_ORDER_TYPE=TA
SAP_DEFAULT_SALES_ORGANIZATION=1010
SAP_DEFAULT_DISTRIBUTION_CHANNEL=10
SAP_DEFAULT_DIVISION=00

# Optional: false oder Pfad zu einem CA-Bundle, falls ein Firmen-Proxy TLS aufbricht
# SAP_VERIFY_SSL=true

# Optional, nur für "python server.py --http"
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
